{
  "servers": [
    {
      "name": "filesystem",
      "url": "built-in",
      "purpose": "Read/write local files \u2014 seckit access",
      "config": {
        "allowed_dirs": [
          "W:\\security",
          "W:\\dev"
        ]
      }
    },
    {
      "name": "github",
      "url": "https://github.com/modelcontextprotocol/servers",
