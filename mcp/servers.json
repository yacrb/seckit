      "requires": "GITHUB_TOKEN"
    },
    {
      "name": "shodan",
      "purpose": "Host/IP intelligence during recon",
      "requires": "SHODAN_API_KEY"
    },
    {
      "name": "virustotal",
      "purpose": "Hash/URL/file reputation lookup",
      "requires": "VT_API_KEY"
    },
    {
      "name": "web-search",
      "url": "built-in",
      "purpose": "Live threat intel, CVE lookup, OSINT"
    }
  ]
