# SecKit .gitignore

# Large binary artifacts
*.mem
*.raw
*.dmp
*.vmem
*.pcap
*.pcapng
*.cap
*.ad1
*.e01
*.l01
*.zip
*.tar.gz
*.7z
*.rar

# VM files
*.vmdk
*.ova
*.ovf
*.vdi
*.vhd
*.vhdx
*.iso

# Windows tool binaries (re-download on new machine)
tools/windows/**/*.exe
tools/windows/**/*.dll
tools/windows/**/bin/

# Secrets / local config
*.key
*.secret
.env

# OS noise
.DS_Store
Thumbs.db
desktop.ini
*~

# Output dirs generated by scripts
vol-output-*/
pcap-triage-*/
foremost-out/
linux-triage-*/
port-scan-*/
subdomain-enum-*/
dir-bust-*/
hash-crack-*/
privesc-check-*/
sqli-test-*/
fuzz-params-*/

# Bootstrap artifacts
.bootstrap-build/
.bootstrap-logs/
