# SecKit .gitignore

# Large binary artifacts
*.mem
*.raw
*.dmp
*.vmem
*.pcap
*.pcapng
*.cap
*.ad1
*.e01
*.l01
*.zip
*.tar.gz
*.7z
*.rar

# VM files
*.vmdk
*.ova
*.ovf
*.vdi
*.vhd
*.vhdx
*.iso

# Submodule contents tracked separately
wordlists/SecLists/
wordlists/PayloadsAllTheThings/
tools/linux/volatility3/
tools/cross/impacket/

# Windows tool binaries (re-download on new machine)
tools/windows/**/*.exe
tools/windows/**/*.dll
tools/windows/**/bin/

# OS noise
.DS_Store
Thumbs.db
desktop.ini
*~

# Output dirs generated by scripts
vol-output-*/
pcap-triage-*/
foremost-out/
